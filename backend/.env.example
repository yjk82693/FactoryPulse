# Copy to a local file you do not commit. Names only — never put values in git.
# AUTH_DISABLED=true is local development only. It is not production security.
# Environment values are examples only. Supply real credentials outside Git.
APP_ENV=development
AUTH_DISABLED=true
SIM_ENABLED=true
SENSOR_ID=csi-rx-01
SENSOR_INGEST_KEY=
DATABASE_URL=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
DEMO_AUTO_JOIN=false
# ElevenLabs secret starts with sk_ (not the key ID shown in the dashboard list).
# Library voices via the API require a paid plan or credits; free accounts return 402.
# Gemini explain (backend only). Never put this key in frontend Vite env.
# Default Flash-Lite: generateContent Standard free tier (input/output free of charge).
# See https://ai.google.dev/gemini-api/docs/pricing — not Gemini 4 Argon (paid-only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
