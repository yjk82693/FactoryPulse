# Frontend flags (names only). Copy to .env and set values locally.
# Never put backend, database, sensor, ElevenLabs, or Gemini secrets here.
# Never put an Auth0 Client Secret in the frontend. SPA apps use Domain + Client ID only.

# Demo Mode default. For Live Mode against local FastAPI see docs/live-csi.md
# (VITE_DEMO_MODE=false, VITE_AUTH_DISABLED=true). Never put SENSOR_INGEST_KEY here.
VITE_DEMO_MODE=true
VITE_AUTH_DISABLED=true
# Live Console HTTP adapter. B's GET /api/console/catalog exists on current FastAPI.
# Keep false for the live-cell demo: HTTP catalog seeds zones/templates but no machines,
# so Machines/Simulator would look empty. Demo Mode always uses in-memory mocks.
# Failed HTTP fetches do not fall back to mock seed data.
VITE_CONSOLE_HTTP=false
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://factorypulse-api
